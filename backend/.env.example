NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://suryadesk:replace-me@127.0.0.1:55432/suryadesk
JWT_SECRET=replace-with-a-random-32-byte-secret
# Gmail delivery takes precedence when both Gmail values are set.
# GMAIL_USER=your-address@gmail.com
# GMAIL_APP_PASSWORD=your-google-app-password
# Resend is available when Gmail is unconfigured.
# CUSTOMER_EMAIL_FROM=SuryaDesk <support@your-verified-domain.example>
# RESEND_API_KEY=
# Optional Razorpay Test Mode credentials, used only by the backend.
# RAZORPAY_KEY_ID=rzp_test_replaceMe
# RAZORPAY_KEY_SECRET=
# Optional SEED_DEMO_PASSWORD is for new local demo users only.
# Optional invoice seller details. Use your registered business information.
# INVOICE_SELLER_NAME=SuryaDesk
# INVOICE_SELLER_ADDRESS=
# INVOICE_SELLER_PAN=
# INVOICE_SELLER_GSTIN=
